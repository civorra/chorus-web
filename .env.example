# ── Anthropic ────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-4-5

# ── Chorus ───────────────────────────────────────────────────
# Répertoire racine de Chorus (contient run.pl, sandboxes/, etc.)
CHORUS_HOME=/path/to/chorus

# Interpréteur Perl (optionnel — défaut : perl dans le PATH)
# PERL_BIN=/usr/local/bin/perl

# ── Serveur ──────────────────────────────────────────────────
PORT=3000

# En production, restreindre l'origine autorisée
# CORS_ORIGIN=http://localhost:3000
