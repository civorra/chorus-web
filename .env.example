# Perl interpreter (optional — default: perl in PATH)
# PERL_BIN=/usr/local/bin/perl

# ── Server ───────────────────────────────────────────────────
PORT=3000

# In production, restrict the allowed origin
# CORS_ORIGIN=http://localhost:3000

# ── ECA Provider (eca-server) ─────────────────────────────────
# These variables control eca-config.json (mounted as a volume in the container).
# Switching provider = edit .env + docker-compose restart eca-server.
# No image rebuild required.
#
# ── Profile A: Anthropic Max / Pro (ECA OAuth — default) ──────
# No variables to define: the docker-compose defaults are correct.
# db.transit.json must contain a valid Anthropic token (Emacs ECA session).
#
# ANTHROPIC_PROVIDER_TYPE=max
# ECA_DEFAULT_MODEL=anthropic/claude-sonnet-4-6
# ECA_MODEL_ARCHITECT=anthropic/claude-sonnet-5
# ECA_MODEL_CODE=anthropic/claude-sonnet-4-6
# ECA_MODEL_FAST=anthropic/claude-haiku-4-5-20251001
#
# ── Profile B: GitHub Copilot Enterprise ──────────────────────
# db.transit.json must contain a valid GitHub Copilot token.
# Adjust model IDs according to the models available on your tenant.
#
# ECA_DEFAULT_MODEL=github-copilot/claude-sonnet-5
# ANTHROPIC_PROVIDER_TYPE=oauth
# ECA_MODEL_ARCHITECT=github-copilot/claude-sonnet-5
# ECA_MODEL_CODE=github-copilot/claude-sonnet-5
# ECA_MODEL_FAST=github-copilot/claude-haiku-4-5

# ── Chorus ───────────────────────────────────────────────────
# Racine commune Chorus (contient engine/ et web/ comme sous-dossiers).
# Utilisé comme préfixe par défaut pour ENGINE_HOME et WEB_HOME.
CHORUS_HOME=~/Chorus

# Chemin vers le repo chorus-engine sur l'hôte.
# Valeur par défaut : ${CHORUS_HOME}/engine
# CHORUS_ENGINE_HOME=~/Chorus/engine

# Chemin vers ce repo (chorus-web) sur l'hôte.
# Valeur par défaut : ${CHORUS_HOME}/web
# CHORUS_WEB_HOME=~/Chorus/web

# URL du repo engine (utilisé par setup.sh pour le clonage initial).
# CHORUS_ENGINE_REPO=https://github.com/civorra/Chorus.git
# CHORUS_ENGINE_BRANCH=devel

# Sandbox root — par défaut : sous engine/sandboxes/.
# SANDBOXES=~/Chorus/sandboxes

# ── Webapp auth — OAuth client IDs ───────────────────────────
# Override if you register your own OAuth Apps:
#   Anthropic : console.anthropic.com → OAuth Apps
#   GitHub    : github.com/settings/apps → New OAuth App
#
# ANTHROPIC_OAUTH_CLIENT_ID=9d1c250a-e61b-44d9-88ed-5944d1962f5e
# ANTHROPIC_OAUTH_SCOPE=org:create_api_key user:profile user:inference
# COPILOT_OAUTH_CLIENT_ID=Iv1.b507a08c87ecfe98
#
# ECA binary (for the OAuth auth subprocess in chorus-web).
# Name of the eca-server container to restart after /api/auth/apikey.
# Default value: automatic Compose naming (<project>-eca-server-1).
# Check with: docker ps --format '{{.Names}}' | grep eca
# ECA_CONTAINER_NAME=chorus-web-eca-server-1

# ── LLM Provider ─────────────────────────────────────────────
# OAUTH_CREDENTIALS=$HOME/.cache/eca/db.transit.json

# ── Anthropic API key (Docker secret) ─────────────────────────
# Path to the file containing the Anthropic API key on the host.
# Adjust to the current Unix account (e.g. /home/yourname/.config/anthropic/api_key).
# ANTHROPIC_API_KEY_FILE=~/.config/anthropic/api_key
