# Interpréteur Perl (optionnel — défaut : perl dans le PATH)
# PERL_BIN=/usr/local/bin/perl

# ── Serveur ──────────────────────────────────────────────────
PORT=3000

# En production, restreindre l'origine autorisée
# CORS_ORIGIN=http://localhost:3000

# ── LLM Provider ─────────────────────────────────────────────
OAUTH_CREDENTIALS=$HOME/.cache/eca/db.transit.json

ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-4-5

# ── Provider ECA (eca-server) ─────────────────────────────────
# Ces variables pilotent eca-config.json (monté en volume dans le conteneur).
# Changer de provider = éditer .env + docker-compose restart eca-server.
# Pas de rebuild d'image requis.
#
# ── Profil A : Anthropic Max / Pro (OAuth ECA — défaut) ───────
# Aucune variable à définir : les défauts docker-compose sont corrects.
# db.transit.json doit contenir un token Anthropic valide (session Emacs ECA).
#
# ECA_DEFAULT_MODEL=anthropic/claude-sonnet-4-6
# ANTHROPIC_PROVIDER_TYPE=max
# ECA_MODEL_ARCHITECT=anthropic/claude-sonnet-5
# ECA_MODEL_CODE=anthropic/claude-sonnet-4-6
# ECA_MODEL_FAST=anthropic/claude-haiku-4-5-20251001
#
# ── Profil B : GitHub Copilot Enterprise ──────────────────────
# db.transit.json doit contenir un token GitHub Copilot valide.
# Adapter les model IDs selon les modèles disponibles sur votre tenant.
#
# ECA_DEFAULT_MODEL=github-copilot/claude-sonnet-4-5
# ANTHROPIC_PROVIDER_TYPE=oauth
# ECA_MODEL_ARCHITECT=github-copilot/claude-sonnet-4-5
# ECA_MODEL_CODE=github-copilot/claude-sonnet-4-5
# ECA_MODEL_FAST=github-copilot/claude-haiku-4-5

# ── Chorus ───────────────────────────────────────────────────
# Répertoire racine de Chorus (contient run.pl, sandboxes/, etc.)
CHORUS_HOME=/path/to/chorus
SANDBOXES=/path/to/sandboxes

# ── Auth webapp (Phase 1) ─────────────────────────────────────
# Nom du conteneur eca-server à redémarrer après /api/auth/apikey.
# Valeur par défaut : nommage Compose automatique (<project>-eca-server-1).
# Vérifier avec : docker ps --format '{{.Names}}' | grep eca
# ECA_CONTAINER_NAME=chorus-web-eca-server-1


